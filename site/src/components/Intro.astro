---
import { serviceArea } from '../data/site';
---
<!-- Left-aligned, held to the left ~60% of the column, with the whitespace to
     the right left open. Deliberate asymmetry — there is no right-hand column
     and nothing is going to arrive to fill it. -->
<section class="px-gutter pt-section pb-section">
  <div class="max-w-[1240px] mx-auto rise">
    <h2 class="text-h2 max-w-[20ch]">Unique and sophisticated designs, laid by hand.</h2>
    <p class="font-read text-body text-ink-soft max-w-[58ch] mt-8">
      A team of finishing specialists covering all aspects — Venetian plaster and
      microcement, from a single feature wall to a full house. Bathrooms, wet rooms,
      staircases, media walls, swimming pool areas and floors, in homes and commercial
      spaces, {serviceArea.toLowerCase()}.
    </p>
  </div>
</section>
