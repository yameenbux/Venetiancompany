---
import BookCall from './BookCall.astro';
import { phone, contactName, serviceArea, instagram, tilingPartner } from '../data/site';
---
<section id="contact" class="px-gutter py-section">
  <div class="max-w-[1240px] mx-auto rise">
    <p class="label">Enquiries <span class="text-accent">&middot;</span> {contactName}</p>
    <h2 class="text-h2 uppercase mt-5">Let's talk<br>about the finish</h2>

    <a class="inline-block font-display font-semibold [font-stretch:125%] text-h2
              tabular-nums text-accent no-underline mt-12 relative
              after:absolute after:left-0 after:bottom-[.06em] after:h-px after:w-full after:bg-accent
              after:origin-right after:scale-x-0 hover:after:origin-left hover:after:scale-x-100
              after:transition-transform after:duration-240 after:ease-slow"
       href={`tel:${phone.e164}`}>{phone.display}</a>

    <div class="mt-20"><BookCall variant="solid" label="Book a call" /></div>

    <div class="grid gap-8 md:grid-cols-3 mt-[clamp(3rem,7vw,5rem)] pt-8 border-t border-ink/15">
      <div>
        <h4 class="label m-0 mb-2">Direct</h4>
        <p class="m-0"><a class="no-underline border-b border-ink/15 hover:border-accent hover:text-accent" href={`tel:${phone.e164}`}>{phone.display}</a><br />{contactName}<br /><span class="text-ink-mute">Covering the UK, {serviceArea.toLowerCase()}</span></p>
      </div>
      <div>
        <h4 class="label m-0 mb-2">Instagram</h4>
        <p class="m-0"><a class="no-underline border-b border-ink/15 hover:border-accent hover:text-accent" href={instagram} target="_blank" rel="noopener">@thevenetiancompany_</a></p>
      </div>
      <div>
        <h4 class="label m-0 mb-2">Tiling</h4>
        <p class="m-0"><a class="no-underline border-b border-ink/15 hover:border-accent hover:text-accent" href={tilingPartner} target="_blank" rel="noopener">@sktiling</a></p>
      </div>
    </div>
    <!-- TODO: email and trading address — not published by the client, ask Adam. -->
  </div>
</section>
