---
import { asset } from '../lib/asset';
---
<!-- The one moving image on the page, and it sits between the process and the
     money — the last look at the work before the buyer is asked to think about
     cost. Full bleed, no caption burned into it, no controls chrome: it behaves
     like the photographs, which is the only reason it belongs in a layout this
     quiet. The poster carries it if the clip cannot decode. -->
<section class="relative">
  <video class="w-full h-[clamp(22rem,62vh,40rem)] object-cover"
         poster={asset('assets/staircase-poster.jpg')}
         muted playsinline loop preload="none"
         aria-label="A stair run finished in polished plaster, filmed on site">
    <source src={asset('assets/staircase.mp4')} type="video/mp4" />
  </video>
</section>
<div class="px-gutter">
  <p class="max-w-[1240px] mx-auto font-read text-caption text-ink-mute mt-4 mb-0">
    Filmed on site. Every wall is mixed, laid and finished by hand.
  </p>
</div>
