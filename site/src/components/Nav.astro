---
import Monogram from './Monogram.astro';
import { whatsappCall } from '../data/site';
const links = [
  ['#work', 'The work'], ['#material', 'The material'],
  ['#process', 'The process'], ['#terms', 'What it costs'],
];
---
<!-- Three elements, and that is the whole header: menu, wordmark, one link.
     The previous version carried a logo, four section links, a phone pill and
     a filled button — seven things, which is what makes a header read as a
     small-business site rather than a studio. Everything that came out lives
     in the overlay, one tap away. -->
<header id="hdr" class="fixed inset-x-0 top-0 z-60 grid grid-cols-[1fr_auto_1fr] items-center
                        gap-4 px-gutter py-5 transition-colors duration-240 ease-motion">
  <!-- Not a generic burger: three short rules of unequal width. It becomes the
       close X in the same position when the overlay is open. -->
  <button id="navbtn" type="button" aria-expanded="false" aria-controls="navpanel"
          class="justify-self-start inline-flex items-center justify-center w-11 h-11 -ml-3
                 cursor-pointer bg-transparent border-0 text-current p-0
                 opacity-100 hover:opacity-70 transition-opacity duration-240 ease-motion"
          aria-label="Open menu">
    <span class="nav-ico grid gap-[5px] w-[22px]" aria-hidden="true">
      <i class="block h-px bg-current w-full origin-center transition-transform duration-240 ease-motion"></i>
      <i class="block h-px bg-current w-[70%] transition-opacity duration-240 ease-motion"></i>
      <i class="block h-px bg-current w-[85%] origin-center transition-transform duration-240 ease-motion"></i>
    </span>
  </button>

  <!-- The lockup: Adam's own TVC monogram and the full name, together.
       The name was truncating to "Venetian" below sm, which is not the
       business's name — a wordmark that changes what it says depending on the
       window is not a wordmark. It sets on the caption step on a phone and the
       body step from sm, both of which are on the type ladder, so the lockup
       scales without leaving the scale.

       Tracking is --tracking-caps from sm and --tracking-caps-tight below it:
       .18em over twenty characters does not fit a 375px header beside a menu
       button and a call button. Both are declared tokens, so the checker can
       see them. -->
  <a href="#top" class="tap flex items-center gap-2 sm:gap-3 no-underline text-current
                        opacity-100 hover:opacity-70 transition-opacity duration-240 ease-motion">
    <!-- The lockup overflows a 320px header by 17px. Rather than shaving the
         monogram, the gap and the tracking until it just fits — knife-edge on
         the narrowest screen there is — the mark steps out below 360 and the
         name keeps the space. Between the two, the name is the one that has to
         be there. 360 is the floor of every phone still in real use, so the
         monogram is present on all of them. -->
    <Monogram class="block w-[1.7em] h-[1.7em] shrink-0 text-current max-[359px]:hidden"
              title="The Venetian Company" />
    <span class="font-display text-caption sm:text-body uppercase leading-[1.3] whitespace-nowrap
                 tracking-caps-tight sm:tracking-caps">The Venetian Company</span>
  </a>

  <!-- Icon on a phone, words from sm. "Book a call" set in tracked caps is
       about 100px wide, which is a third of a 375 header and was crowding the
       name; a handset says the same thing in 22px and is understood without
       reading. It keeps the words wherever there is room for them, because a
       labelled CTA outperforms an icon whenever both fit — and the icon-only
       state carries the label for screen readers either way. -->
  <a href={whatsappCall} target="_blank" rel="noopener" data-cta="book-call"
     aria-label="Book a call on WhatsApp"
     class="tap justify-self-end flex items-center gap-2 text-current no-underline
            opacity-100 hover:opacity-70 transition-opacity duration-240 ease-motion">
    <svg class="w-[22px] h-[22px] shrink-0 sm:hidden" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="1.25" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true">
      <path d="M8.4 3.6H5.2A2 2 0 0 0 3.2 5.7c0 8.4 6.7 15.1 15.1 15.1a2 2 0 0 0 2.1-2v-3.2l-4.3-1.4-2.1 2.1a15.6 15.6 0 0 1-6.1-6.1l2.1-2.1L8.4 3.6Z"/>
    </svg>
    <span class="hidden sm:inline label text-current pb-1 border-b border-current/40">Book a call</span>
  </a>
</header>

<!-- Full-viewport clay panel. The nav sits in a single horizontal row, and the
     whole thing — panel, ghost shapes and items together — cross-fades at full
     scale. It does not slide, wipe, or expand from the button, and the items do
     not stagger: all five resolve at once, which keeps the moment quiet. -->
<div id="navpanel" hidden data-open="false"
     class="fixed inset-0 z-55 bg-clay invisible opacity-0
            transition-[opacity,visibility] duration-500 ease-motion
            data-[open=true]:visible data-[open=true]:opacity-100">
  <!-- Soft organic shapes in a darker tint of the same clay, low enough in
       contrast to read as a watermark rather than a graphic. -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <svg class="absolute -left-[10%] top-[8%] w-[70%] opacity-45" viewBox="0 0 600 600" fill="none">
      <path d="M120 460c-70-90-40-230 60-300S420 80 500 170s30 250-70 320-240 60-310-30Z" fill="var(--color-clay-2)"/>
    </svg>
    <svg class="absolute -right-[8%] -bottom-[18%] w-[62%] opacity-40" viewBox="0 0 600 600" fill="none">
      <path d="M300 20c150 0 260 130 260 280S440 580 290 580 20 450 20 300 150 20 300 20Z" fill="var(--color-clay-2)"/>
    </svg>
  </div>

  <nav class="relative h-full flex flex-col lg:flex-row items-start lg:items-center justify-center
              lg:justify-evenly gap-2 lg:gap-6 px-gutter pt-28 pb-16" aria-label="Sections">
    {links.map(([href, text]) => (
      <a href={href} class="tap font-display no-underline text-ink text-h3 lg:text-h4
                            whitespace-nowrap py-1 border-b border-transparent hover:border-ink
                            transition-colors duration-240 ease-motion">{text}</a>
    ))}
    <a href={whatsappCall} target="_blank" rel="noopener" data-cta="book-call"
       class="tap font-display no-underline text-ink text-h3 lg:text-h4 whitespace-nowrap py-1
              border-b border-ink/40 hover:border-ink transition-colors duration-240 ease-motion">Book a call</a>
  </nav>
</div>
