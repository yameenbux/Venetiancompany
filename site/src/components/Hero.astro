---
import { asset } from '../lib/asset';
import { serviceArea } from '../data/site';

/* Three of Adam's own rooms. They cross-fade; the title layer above them does
   not move or re-render between slides, so only the photography changes.

   Ordered so the first is the darkest — it is the one the title has to sit on
   while the others are still decoding, and it is the LCP image. */
const slides = [
  { base: 'hero-stair', w: [700, 1000, 1400], alt: 'Marbled plaster wall in deep teal behind a floating oak staircase' },
  { base: 'hero-well',  w: [700, 1050],       alt: 'Double-height stairwell in polished plaster, lit from a skylight' },
  { base: 'hero-arch',  w: [700, 1050],       alt: 'Bathroom in plaster with a freestanding bath beneath an arched window' },
];
const set = (b: string, ws: number[], ext: string) =>
  ws.map((w) => `${asset(`assets/${b}-${w}.${ext}`)} ${w}w`).join(', ');
---
<section class="relative min-h-[100svh] overflow-hidden" id="top">
  <div class="absolute inset-0" id="slides">
    {slides.map((s, i) => (
      <picture>
        <source type="image/webp" sizes="100vw" srcset={set(s.base, s.w, 'webp')} />
        <img class="slide" data-on={i === 0 ? 'true' : 'false'} sizes="100vw"
             srcset={set(s.base, s.w, 'jpg')} src={asset(`assets/${s.base}-${s.w[1]}.jpg`)}
             width="1400" height="1867" alt={i === 0 ? s.alt : ''} aria-hidden={i !== 0}
             fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'}
             decoding={i === 0 ? 'sync' : 'async'} />
      </picture>
    ))}
    <div class="hero-foot" aria-hidden="true"></div>
  </div>

  <!-- Bottom-left, generous left margin, and the scroll cue optically centred
       to its right — the reference's exact anatomy. The title is a scale step,
       not a lockup measured against the viewport: the previous pass set the
       name at 134px and it filled the frame, which is the opposite of the
       restraint this whole direction is built on. -->
  <div class="relative z-1 min-h-[100svh] flex flex-col justify-end px-gutter pb-[clamp(2.5rem,7vh,5rem)]">
    <p class="label text-cream mb-4">Venetian plaster &middot; Microcement &middot; {serviceArea}</p>
    <div class="flex items-end gap-8 flex-wrap">
      <h1 class="text-h2 text-cream max-w-[15ch]">The Venetian Company</h1>
      <a href="#work" class="hidden sm:flex items-center gap-3 no-underline text-cream/80 pb-3
                             hover:text-cream transition-colors duration-240 ease-motion" aria-label="Scroll to the work">
        <svg width="13" height="42" viewBox="0 0 13 42" fill="none" aria-hidden="true">
          <path d="M6.5 0v40M1 34.5 6.5 41 12 34.5" stroke="currentColor" stroke-width="1"/>
        </svg>
      </a>
    </div>
  </div>
</section>
