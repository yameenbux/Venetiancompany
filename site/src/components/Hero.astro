---
import BookCall from './BookCall.astro';
import { serviceArea } from '../data/site';
---
<section class="relative flex items-start md:items-center min-h-[100svh] overflow-hidden
                px-gutter pt-36 md:pt-28 pb-16">
  <div class="arch" aria-hidden="true">
    <img src="/assets/stairwell.jpg" width="1050" height="1400" fetchpriority="high" decoding="async" alt="" />
  </div>

  <div class="relative z-2 w-full max-w-[1240px] mx-auto">
    <p class="label [animation:fadeUp_1.45s_var(--ease-slow)_both] [animation-delay:.18s]">
      Venetian Plaster <span class="text-accent">&middot;</span> Microcement <span class="text-accent">&middot;</span> {serviceArea}
    </p>

    <h1 class="text-d1 uppercase mt-7 tracking-[-.022em]">
      {['The', 'Venetian', 'Company'].map((word, i) => (
        <span class="block overflow-hidden">
          <i class={`block not-italic [animation:lift_1.45s_var(--ease-slow)_both] ${
            i === 0 ? 'text-[.26em] font-normal tracking-[.5em] pl-[.35em]' : ''}`}
            style={`animation-delay:${[.36, .51, .66][i]}s`}>{word}</i>
        </span>
      ))}
    </h1>

    <p class="font-read text-lede leading-[1.55] text-ink-soft max-w-[26ch] mt-8
              [animation:fadeUp_1.45s_var(--ease-slow)_both] [animation-delay:.86s]">
      A team of finishing specialists covering all aspects.
    </p>

    <div class="flex flex-wrap items-center gap-x-10 gap-y-4 mt-12
                [animation:fadeUp_1.45s_var(--ease-slow)_both] [animation-delay:1.04s]">
      <BookCall variant="solid" />
      <div class="flex items-center gap-3 label">
        <span class="relative block w-14 h-px bg-ink-mute overflow-hidden">
          <span class="absolute inset-0 bg-accent [animation:cue_3.4s_var(--ease-out-soft)_infinite]"></span>
        </span>Scroll
      </div>
    </div>
  </div>
</section>
