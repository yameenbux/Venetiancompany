---
import SectionHead from './SectionHead.astro';
import { services, whatsappCall } from '../data/site';
---
<section id="work" class="px-gutter py-section">
  <div class="max-w-[1240px] mx-auto">
    <div class="rise">
      <SectionHead title="Where it<br>goes on"
        lede="Unique and sophisticated designs to suit a variety of homes or commercial spaces — applied by hand, in passes, on site." />
    </div>
    <div class="rise border-t border-ink/15">
      <!-- The 01-09 column is gone. These are nine things they do, not nine
           steps: the order carried no information, so the numbers were
           decoration wearing the costume of structure. What is left is an
           index — names, a rule between each, nothing else. -->
      {services.map((s) => (
        <a href={whatsappCall} target="_blank" rel="noopener"
           class="group relative grid grid-cols-[1fr_auto] items-baseline gap-4 no-underline
                  border-b border-ink/15 py-[clamp(1.1rem,2.6vw,1.7rem)]">
          <span class="font-display text-h3 text-ink
                       transition-transform duration-240 ease-motion group-hover:translate-x-3">{s}</span>
          <!-- Hover-reveal, so it is laid out only where there is room for it.
               Unconditionally it added a ~90px auto column that, against the h3
               step's min-content width, pushed the row 9px past a 360px
               viewport. Gated on width rather than (hover:hover) so a narrow
               desktop window is covered too, not just touch devices. -->
          <span class="hidden md:inline label opacity-0 -translate-x-2
                       transition-all duration-240 ease-motion
                       group-hover:opacity-100 group-hover:translate-x-0">Book a call</span>
          <span class="absolute inset-x-0 -bottom-px h-px bg-slate scale-x-0 origin-left
                       transition-transform duration-240 ease-motion group-hover:scale-x-100"></span>
        </a>
      ))}
    </div>
    <p class="font-display italic text-ink-mute text-caption mt-18">And more — if you have a surface in mind that isn't listed, ask on the call.</p>
  </div>
</section>
