---
import SectionHead from './SectionHead.astro';
import { asset } from '../lib/asset';
import { work } from '../data/site';
const feature = work[0];
const rest = work.slice(1);
---
<section id="recent" class="px-gutter py-section">
  <div class="max-w-[1240px] mx-auto">
    <div class="rise">
      <SectionHead eyebrow="Recent surfaces" title="On site"
        lede="Eight pieces of recent work, one of them film rather than a still — the surface shifts as the light moves across it, which a photograph flattens out." />
    </div>

    <figure class="rise group mb-[clamp(4rem,10vw,7rem)]">
      <div class="relative overflow-hidden rounded-sm bg-paper-3 shadow-[0_20px_40px_-28px_rgba(20,24,26,.45)] aspect-4/5 sm:aspect-16/9">
        <!-- lazy, not eager: the hero is a full viewport, so this sits below the fold
             and eager loading only made 286KB compete with the LCP image for
             bandwidth. First load went 454KB -> 168KB. -->
        <img src={asset(`assets/${feature.file}`)} width={1050} height={1400} loading="lazy" decoding="async"
             alt={feature.alt}
             class="w-full h-full object-cover transition-transform duration-240 ease-motion
                    group-hover:scale-[1.02]" />
      </div>
      <figcaption class="mt-4 flex items-baseline gap-3 label">
        <span class="block w-3.5 h-px bg-accent shrink-0 relative -top-[.28em] transition-all
                         duration-240 ease-motion group-hover:w-7" aria-hidden="true"></span>{feature.caption}
      </figcaption>
    </figure>

    <div class="rise grid gap-[clamp(1.2rem,3vw,2rem)] sm:grid-cols-2 xl:grid-cols-4">
      {rest.map((w) => (
        <figure class="group">
          <div class="relative overflow-hidden rounded-sm bg-paper-3 aspect-3/4
                      shadow-[0_20px_40px_-28px_rgba(20,24,26,.45)]">
            {w.file.endsWith('.mp4') ? (
              <video poster={asset(`assets/${w.poster}`)} width="720" height="1280" muted loop playsinline
                     preload="none" aria-label={w.alt}
                     class="w-full h-full object-cover transition-transform duration-240
                            ease-motion group-hover:scale-[1.02]">
                <source src={asset(`assets/${w.file}`)} type="video/mp4" />
              </video>
            ) : (
              <img src={asset(`assets/${w.file}`)} width={w.w ?? 1050} height={1400} loading="lazy"
                   decoding="async" alt={w.alt}
                   class="w-full h-full object-cover transition-transform duration-240
                          ease-motion group-hover:scale-[1.02]" />
            )}
          </div>
          <figcaption class="mt-4 flex items-baseline gap-3 label">
            <span class="block w-3.5 h-px bg-accent shrink-0 relative -top-[.28em] transition-all
                         duration-240 ease-motion group-hover:w-7" aria-hidden="true"></span>{w.caption}
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="font-read italic text-ink-mute text-caption mt-12">Photography and film by The Venetian Company.</p>
  </div>
</section>
