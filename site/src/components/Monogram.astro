---
/**
 * The company's own TVC monogram — a ring with the T, V and C interlocked down
 * a shared axis, the T's stem running into the V and the V's point into the C.
 *
 * This is a trace of the artwork Adam supplied, not a reconstruction: the JPEG
 * was upscaled 4x, thresholded and run through potrace, and the result agrees
 * with the original at 98.7% IoU (9007 ink pixels against 9008). Do not
 * "tidy" the outlines — the small asymmetries are in his mark.
 *
 * The letterforms are drawn, so they carry no font dependency and inherit
 * currentColor. `disc` paints a lime backing behind the ring for placements
 * over photography; leave it off on a flat ground.
 */
interface Props { class?: string; disc?: boolean; title?: string }
const { class: cls = '', disc = false, title } = Astro.props;
