---
import { asset } from '../lib/asset';

/* Card anatomy, top to bottom: image, hairline rule, category eyebrow, title.
   Two lines of metadata doing the work of a filter UI we do not need yet —
   with nine projects a filter row would be decoration wearing the costume of
   structure. It earns its place when the archive does.

   Every card carries its photograph's OWN dimensions, and the frame is sized
   from them. The reference crops to a uniform 4:3 landscape because it
   commissions its photography and can art-direct the crop. Adam's are phone
   photographs, all portrait, and forcing them into a landscape box threw away
   a quarter of each one — the top of a stairwell, the bottom of a bath. Rows
   no longer align on their lower edge and that is the correct trade: the work
   is the thing being sold, and the whole frame of it now shows.

   The order is by shape, not by preference. Seven of the nine are 3:4 and two
   are 9:16 phone video stills; scattered, those two left one odd card in three
   separate rows. Sat together in row two they read as a pair. Row one is three
   matched 3:4 frames, which is the row that has to look composed.

   Categories are the client's own service names, verbatim. Titles describe
   what is in the photograph; none of these are project or client names,
   because we have not been given any. */
const projects = [
  { file: 'stair-marbled.jpg',  w: 1050, h: 1400, cat: 'Feature walls, Staircases', title: 'Marbled wall behind a floating oak stair' },
  { file: 'stairwell.jpg',      w: 1050, h: 1400, cat: 'Staircases',                title: 'Double-height stairwell, no joins' },
  { file: 'wet-room.jpg',       w: 1050, h: 1400, cat: 'Wet rooms, Microcement',    title: 'Microcement wet room, seamless' },
  { file: 'grid-bathroom.jpg',  w:  720, h: 1280, cat: 'Bathrooms',                 title: 'Bathroom pigmented to colour' },
  { file: 'grid-staircase.jpg', w:  720, h: 1280, cat: 'Staircases, Feature walls', title: 'Stair run in polished plaster' },
  { file: 'bathroom-arch.jpg',  w: 1050, h: 1400, cat: 'Bathrooms',                 title: 'Plaster against marble, arched window' },
  { file: 'fireplace.jpg',      w: 1136, h: 1400, cat: 'Feature walls',             title: 'Chimney breast worked by hand' },
  { file: 'texture-switch.jpg', w: 1050, h: 1400, cat: 'Full house applications',   title: 'Coarse grain against walnut' },
  { file: 'plaster-detail.jpg', w: 1050, h: 1400, cat: 'Feature walls',             title: 'The trowel, up close' },
];
const FIRST = 6;
---
<section id="work" class="px-gutter pt-section pb-section">
  <div class="max-w-[1240px] mx-auto">
    <!-- items-start, so a taller photograph does not stretch the cards beside
         it. Each figure is exactly as tall as its own image plus its caption. -->
    <div id="grid" class="grid items-start gap-x-[clamp(1rem,2.4vw,2.1rem)] gap-y-[clamp(2.5rem,4vw,3.5rem)]
                          sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, i) => (
        <figure class={`group rise m-0 ${i >= FIRST ? 'more' : ''}`} hidden={i >= FIRST}>
          <!-- The frame takes the image's ratio, so object-cover has nothing to
               cut. It stays object-cover rather than contain because contain
               would letterbox on the rounding, and stays overflow-hidden so the
               hover scale is contained. -->
          <div class="overflow-hidden bg-cream-2" style={`aspect-ratio:${p.w}/${p.h}`}>
            <img src={asset(`assets/${p.file}`)} alt={p.title} loading={i < 3 ? 'eager' : 'lazy'}
                 decoding="async" width={p.w} height={p.h}
                 class="w-full h-full object-cover transition-transform duration-240 ease-motion
                        group-hover:scale-[1.02]" />
          </div>
          <!-- Hairline rules are the only separator device on this page. No
               cards, no shadows, no borders around the images. -->
          <hr class="border-0 border-t border-rule mt-4 mb-3" />
          <figcaption>
            <p class="label m-0">{p.cat}</p>
            <p class="font-display text-h4 text-ink m-0 mt-1 transition-colors duration-240 ease-motion
                       group-hover:text-clay-ink">{p.title}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Progressive loading with an explicit count, not infinite scroll. Nine
         is everything we have been given; the counter tells the truth about
         that rather than implying an archive behind it. -->
    <div class="text-center mt-[clamp(2.5rem,5vw,4rem)]">
      <button id="loadmore" type="button"
              class="label text-clay-ink bg-transparent border-0 cursor-pointer p-2
                     border-b border-transparent hover:border-clay-ink
                     transition-colors duration-240 ease-motion">Load more</button>
      <p id="count" class="font-read text-caption text-ink-mute m-0 mt-1">{FIRST} of {projects.length}</p>
    </div>
  </div>
</section>
