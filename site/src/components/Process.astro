---
import { process } from '../data/site';
---
<!-- Numbered, and here the numbers are load-bearing: these four happen in this
     order and the reader needs to know which comes before the deposit. The
     service list upstairs is not a sequence and carries no numbers. -->
<section id="process" class="px-gutter py-section border-t border-rule">
  <div class="max-w-[1240px] mx-auto">
    <h2 class="text-h2 max-w-[14ch] rise">How a job runs.</h2>
    <ol class="rise list-none p-0 m-0 mt-head grid gap-x-[clamp(1.5rem,4vw,4rem)] gap-y-10 md:grid-cols-2">
      {process.map((s) => (
        <li class="border-t border-rule pt-5">
          <p class="label m-0">{s.n}</p>
          <h3 class="text-h4 mt-2">{s.title}</h3>
          <p class="font-read text-body text-ink-soft max-w-[46ch] mt-3">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
