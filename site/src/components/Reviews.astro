---
import SectionHead from './SectionHead.astro';
/* Structure only. CLAUDE.md forbids inventing testimonials — these stay marked
   as placeholders until Adam supplies three real ones. */
---
<section id="reviews" class="px-gutter py-section">
  <div class="max-w-[1240px] mx-auto rise">
    <SectionHead title="What clients<br>say"
      lede="Three short quotes from recent customers sit here — a line each on the finish, the tidiness of the job and whether we turned up when we said we would." />
    <div class="grid gap-[clamp(1.2rem,3vw,1.8rem)] md:grid-cols-3">
      {[0, 1, 2].map(() => (
        <div class="flex flex-col gap-4 border border-dashed border-stone rounded-sm
                    p-[clamp(1.4rem,3vw,2rem)] bg-white/40">
          <div class="font-read text-h3 leading-none text-slate opacity-50" aria-hidden="true">&ldquo;</div>
          <p class="font-display italic text-ink-mute m-0 flex-1">Client quote to be supplied.</p>
          <p class="label border-t border-ink/15 pt-4 m-0">
            <span class="text-label text-stone" aria-hidden="true">&#9734;&#9734;&#9734;&#9734;&#9734;</span><br />Name, area — project type
          </p>
        </div>
      ))}
    </div>
    <p class="label text-slate inline-flex items-center gap-3 mt-14">
      <span class="w-1.5 h-1.5 rounded-full bg-slate" aria-hidden="true"></span>Placeholder — real reviews needed before this goes live
    </p>
  </div>
</section>
