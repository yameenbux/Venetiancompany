---
import SectionHead from './SectionHead.astro';
import { materials } from '../data/site';
---
<section id="materials" class="px-gutter py-section">
  <div class="max-w-[1240px] mx-auto">
    <div class="rise">
      <SectionHead title="Plaster or<br>cement?"
        lede="They get used interchangeably and they aren't the same thing. Which one suits your room depends mostly on what the surface has to put up with." />
    </div>
    <div class="rise grid gap-[clamp(2rem,5vw,3.5rem)] lg:grid-cols-2">
      {materials.map((m) => (
        <div class="border-t border-ink pt-6">
          <h3 class="text-h3 mb-2">{m.name}</h3>
          <p class="font-display italic text-slate text-caption mb-5 mt-0">{m.make}</p>
          {m.body.map((para) => <p class="font-read text-ink-soft mb-4 mt-0">{para}</p>)}
          <ul class="list-none p-0 mt-6 grid gap-2">
            {m.where.map((w) => (
              <li class="label flex items-baseline gap-3">
                <span class="block w-2.5 h-px bg-slate shrink-0 relative -top-[.3em]" aria-hidden="true"></span>{w}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
