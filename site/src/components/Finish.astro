---
import { about, finishes } from '../data/site';
---
<section id="finish" class="relative px-gutter py-section text-paper
  bg-[radial-gradient(90%_70%_at_20%_0%,rgba(18,80,79,.20)_0%,rgba(18,80,79,0)_55%),radial-gradient(80%_60%_at_90%_100%,rgba(168,172,170,.16)_0%,rgba(168,172,170,0)_60%),linear-gradient(172deg,#141A1C_0%,#101416_55%,#0A0D0E_100%)]">
  <div class="relative z-1 max-w-[1240px] mx-auto">
    <div class="rise">
      <div class="grid gap-6 mb-head md:grid-cols-[minmax(21rem,1fr)_minmax(0,26rem)] md:items-end">
        <div>
          <p class="label text-stone mb-5">The material</p>
          <h2 class="text-h2 uppercase">The material<br>is the point</h2>
        </div>
        <p class="font-read text-lede text-paper/70 max-w-[42ch] m-0">
          Lime and cement finishes that are laid, burnished and sealed on site. No joins, no seams, no two walls identical.
        </p>
      </div>
    </div>

    <div class="rise grid gap-[clamp(2rem,6vw,4.5rem)] lg:grid-cols-[1.05fr_.95fr] items-start">
      <div>{about.map((p) => <p class="font-read text-lede text-paper/[.78] mb-4 mt-0">{p}</p>)}</div>
      <blockquote class="font-display font-semibold uppercase [font-stretch:125%] text-h3
                         border-l border-accent-lt pl-[clamp(1rem,3vw,2rem)]">
        Every wall is mixed, laid and finished by hand.
      </blockquote>
    </div>

    <div class="rise mt-[clamp(3rem,7vw,5rem)] pt-[clamp(2rem,5vw,3rem)] border-t border-paper/15">
      <div class="grid gap-4 mb-[clamp(1.5rem,4vw,2.4rem)] md:grid-cols-[minmax(0,14rem)_minmax(0,44ch)] md:items-baseline md:gap-10">
        <p class="label text-stone">The range</p>
        <p class="font-read text-paper/70 m-0">Six surfaces from recent projects. Your finish and colour are agreed with you before anything starts.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-[clamp(.6rem,1.6vw,1.1rem)]">
        {finishes.map((f) => (
          <figure class="group relative aspect-3/4 rounded-sm overflow-hidden bg-[#1B2022]">
            <img src={`/assets/${f.file}`} width={f.w ?? 600} height={f.h ?? 800}
                 loading="lazy" decoding="async" alt={f.alt}
                 class="w-full h-full object-cover transition-transform duration-240 ease-motion
                        group-hover:scale-[1.03]" />
            <!-- The scrim is tall so the gradient has room to fade. At from-black/45
                 over a 61px band the caption sat at about 22% alpha, and white on
                 these pale plasters measured 2.45:1 on Textured. The bright end of
                 the set needs alpha .44 at the text; these stops hold about .60. -->
            <b class="absolute inset-x-0 bottom-0 pt-9 px-2 pb-2 sm:pt-10 sm:px-3 sm:pb-3
                      font-normal text-label uppercase text-white
                      bg-gradient-to-t from-black/80 via-black/55 to-transparent
                      [text-shadow:0_1px_6px_rgba(0,0,0,.6)]">{f.name}</b>
          </figure>
        ))}
      </div>
      <p class="font-read italic text-paper/[.62] text-caption mt-4 max-w-[40ch]">
        Photographed on site, not on sample boards — this is how each one landed on a real wall.
      </p>
    </div>
  </div>
</section>
