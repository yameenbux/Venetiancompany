__pycache__/
*.pyc
.env
.venv/
venv/
.ipynb_checkpoints/
html_outputs/*
!html_outputs/.gitkeep

# built from index.html by build-artifact.py
samples/venetian-company/artifact.html

# built by build-site.py
dist/

# MCP server config — written by `claude mcp add -s project` and by the
